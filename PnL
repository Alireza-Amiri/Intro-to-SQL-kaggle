import numpy as np
import pandas as pd

def _linear_extrapolate(x, y, x_new):
    """
    Interpolate linearly within [x_min, x_max] and extrapolate linearly
    outside that range using the end slopes.
    x: 1D array (monotonic)
    y: 1D array (same length as x)
    x_new: 1D array of target x's
    returns: y_new aligned to x_new
    """
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    x_new = np.asarray(x_new, dtype=float)

    # ensure sorted by x
    order = np.argsort(x)
    x, y = x[order], y[order]

    # interior interpolation
    y_new = np.interp(x_new, x, y)

    # left extrapolation (x_new < x0)
    left_mask = x_new < x[0]
    if np.any(left_mask) and len(x) >= 2:
        slope_left = (y[1] - y[0]) / (x[1] - x[0])
        y_new[left_mask] = y[0] + (x_new[left_mask] - x[0]) * slope_left

    # right extrapolation (x_new > xN)
    right_mask = x_new > x[-1]
    if np.any(right_mask) and len(x) >= 2:
        slope_right = (y[-1] - y[-2]) / (x[-1] - x[-2])
        y_new[right_mask] = y[-1] + (x_new[right_mask] - x[-1]) * slope_right

    return y_new

def interpolate_ccar(df, day_col="Days_CCAR", scenario_prefix="CCAR_", targets=None):
    """
    df: wide CCAR shock table (like in your screenshot)
        must contain 'Days_CCAR' and several columns such as 'CCAR_2016_SA', ...
    targets: list/array of target day tenors to interpolate/extrapolate to.
             Example: [30, 60, 91, 180, 365, 730, 1095]
    returns: DataFrame indexed by target days with one column per CCAR scenario
    """
    if targets is None:
        raise ValueError("Provide a list of target day tenors in `targets`.")

    # Make a clean copy and keep numeric day axis
    work = df.copy()
    work = work.dropna(subset=[day_col])
    work[day_col] = pd.to_numeric(work[day_col], errors="coerce")
    work = work.dropna(subset=[day_col])

    # Scenario columns = all that start with 'CCAR_' (adjust if you need another rule)
    scen_cols = [c for c in work.columns if str(c).upper().startswith(scenario_prefix)]
    if not scen_cols:
        raise ValueError("No scenario columns found (e.g., columns starting with 'CCAR_').")

    # Prepare output
    out = pd.DataFrame(index=pd.Index(np.array(targets, dtype=float), name=day_col))

    x = work[day_col].values
    for col in scen_cols:
        y = pd.to_numeric(work[col], errors="coerce").values
        mask = np.isfinite(x) & np.isfinite(y)
        if mask.sum() < 2:
            # Not enough points; fill with NaN
            out[col] = np.nan
            continue
        out[col] = _linear_extrapolate(x[mask], y[mask], out.index.values)

    return out.sort_index()

