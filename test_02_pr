import pandas as pd
import numpy as np

# ============================================================
# 1. Load price data
# ============================================================
# Expected CSV format:
# Date, SPY, QQQ, TSLA, KO, PG, HYG, TLT, IEF, LQD, BIL, SHV, MBB

file_path = "your_price_data.csv"  # change this

prices = pd.read_csv(file_path)
prices["Date"] = pd.to_datetime(prices["Date"])
prices = prices.set_index("Date").sort_index()

# Keep only available columns
prices = prices.dropna(axis=1, how="all")

# ============================================================
# 2. Calculate daily simple returns
# ============================================================

returns = prices.pct_change()

# ============================================================
# 3. Function to calculate forward multi-day returns
# ============================================================

def rolling_horizon_return(price_df, horizon):
    """
    Calculates horizon-day return.
    Example: 5-day return = P_t / P_t-5 - 1
    """
    return price_df / price_df.shift(horizon) - 1


returns_1d = rolling_horizon_return(prices, 1)
returns_3d = rolling_horizon_return(prices, 3)
returns_5d = rolling_horizon_return(prices, 5)

# ============================================================
# 4. Historical stress statistics
# ============================================================

def stress_stats(return_df):
    stats = pd.DataFrame(index=return_df.columns)

    stats["Worst Loss"] = return_df.min()
    stats["95th Percentile Loss"] = return_df.quantile(0.05)
    stats["99th Percentile Loss"] = return_df.quantile(0.01)

    return stats

stress_1d = stress_stats(returns_1d)
stress_3d = stress_stats(returns_3d)
stress_5d = stress_stats(returns_5d)

# ============================================================
# 5. Define model proxy haircuts
# ============================================================
# These are examples based on the model table.
# Adjust these if your actual table uses different bucket mapping.

model_haircuts = pd.DataFrame({
    "Model Bucket": [
        "Equity / Mutual Fund Low Vol",
        "Equity / Mutual Fund Medium Vol",
        "Equity / Mutual Fund High Vol",
        "Money Market",
        "Private Label / ABS",
        "VRDN",
        "Warrant",
        "Treasury 3-10Y",
        "Treasury 10-20Y",
        "Treasury 20Y+",
        "Investment Grade Corporate",
        "BBB Corporate",
        "High Yield Corporate"
    ],
    "Proxy Ticker": [
        "SPY",
        "QQQ",
        "TSLA",
        "BIL",
        "MBB",
        "SHV",
        "TSLA",
        "IEF",
        "TLT",
        "TLT",
        "LQD",
        "LQD",
        "HYG"
    ],
    "Model Haircut": [
        0.15,  # 85% MV
        0.25,  # 75% MV
        0.50,  # 50% MV
        0.02,  # 98% MV
        0.40,  # 60% MV
        0.08,  # 92% MV
        0.50,  # 50% MV
        0.04,  # 96% MV
        0.06,  # 94% MV
        0.09,  # 91% MV
        0.05,  # example IG corp
        0.10,  # example BBB corp
        0.20   # example HY / lower rated
    ]
})

# Keep only rows where proxy exists in your data
model_haircuts = model_haircuts[
    model_haircuts["Proxy Ticker"].isin(prices.columns)
].copy()

# ============================================================
# 6. Compare model haircut to historical drawdowns
# ============================================================

results = []

for _, row in model_haircuts.iterrows():
    ticker = row["Proxy Ticker"]
    haircut = row["Model Haircut"]

    worst_1d = stress_1d.loc[ticker, "Worst Loss"]
    worst_3d = stress_3d.loc[ticker, "Worst Loss"]
    worst_5d = stress_5d.loc[ticker, "Worst Loss"]

    p95_1d = stress_1d.loc[ticker, "95th Percentile Loss"]
    p99_1d = stress_1d.loc[ticker, "99th Percentile Loss"]

    results.append({
        "Model Bucket": row["Model Bucket"],
        "Proxy Ticker": ticker,
        "Model Haircut %": haircut * 100,
        "Worst 1D Loss %": abs(worst_1d) * 100,
        "Worst 3D Loss %": abs(worst_3d) * 100,
        "Worst 5D Loss %": abs(worst_5d) * 100,
        "1D 95th Percentile Loss %": abs(p95_1d) * 100,
        "1D 99th Percentile Loss %": abs(p99_1d) * 100,
        "Cushion vs Worst 1D %": (haircut - abs(worst_1d)) * 100,
        "Cushion vs Worst 5D %": (haircut - abs(worst_5d)) * 100
    })

proxy_results = pd.DataFrame(results)

# ============================================================
# 7. Add assessment flag
# ============================================================

def assess_proxy(row):
    if row["Cushion vs Worst 1D %"] >= 0 and row["Cushion vs Worst 5D %"] >= 0:
        return "Conservative vs historical 1D and 5D drawdowns"
    elif row["Cushion vs Worst 1D %"] >= 0 and row["Cushion vs Worst 5D %"] < 0:
        return "Conservative vs 1D, but below worst 5D stress"
    else:
        return "Potentially below historical 1D stress"

proxy_results["Assessment"] = proxy_results.apply(assess_proxy, axis=1)

print(proxy_results.round(2))

# ============================================================
# 8. Export results
# ============================================================

proxy_results.round(2).to_excel(
    "proxy_assessment_haircuts_vs_historical_drawdowns.xlsx",
    index=False
)

print("Output saved: proxy_assessment_haircuts_vs_historical_drawdowns.xlsx")
