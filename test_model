import os
import math
from dataclasses import dataclass
from typing import Optional, List, Tuple

import pandas as pd
import QuantLib as ql


class HW1FCalibBase:
    """
    Base class for local Hull-White 1F calibration.
    This replaces internal DB/module dependencies with local CSV loading.
    """

    def __init__(self, output_folder: str = "output", currency: str = "USD"):
        self.output_folder = output_folder
        self.currency = currency.upper()
        os.makedirs(self.output_folder, exist_ok=True)

        self.df_loaded_curve: Optional[pd.DataFrame] = None
        self.df_loaded_swaption_vol: Optional[pd.DataFrame] = None

        self.country_map = {
            "USD": "UnitedStates",
            "GBP": "UnitedKingdom",
            "EUR": "TARGET",
            "JPY": "Japan",
            "CAD": "Canada",
            "AUD": "Australia",
        }

    def load_curve(self, curve_input):
        """
        Load local curve file or DataFrame.

        Expected columns:
        - Date
        - Tenor
        - Rate

        Date format example: 2024-09-10
        Tenor is in days
        Rate is decimal, e.g. 0.0483 for 4.83%
        """
        if isinstance(curve_input, str):
            self.df_loaded_curve = pd.read_csv(curve_input)
        elif isinstance(curve_input, pd.DataFrame):
            self.df_loaded_curve = curve_input.copy()
        else:
            raise ValueError("curve_input must be a CSV path or a pandas DataFrame")

        required_cols = {"Date", "Tenor", "Rate"}
        missing = required_cols - set(self.df_loaded_curve.columns)
        if missing:
            raise ValueError(f"Curve data missing columns: {missing}")

        self.df_loaded_curve["Date"] = pd.to_datetime(self.df_loaded_curve["Date"])
        self.df_loaded_curve["Tenor"] = self.df_loaded_curve["Tenor"].astype(int)
        self.df_loaded_curve["Rate"] = self.df_loaded_curve["Rate"].astype(float)

    def load_swaption_vol(self, vol_input):
        """
        Load local swaption vol file or DataFrame.

        Expected columns:
        - Date
        - Swaption
        - Volatility
        - Swap_term
        - Option_term
        - Swap_term_unit
        - Option_term_unit
        - Model_type
        - Shift

        Volatility should be decimal, e.g. 0.0105
        Model_type typically Normal or Lognormal
        Shift typically 0.0
        """
        if isinstance(vol_input, str):
            self.df_loaded_swaption_vol = pd.read_csv(vol_input)
        elif isinstance(vol_input, pd.DataFrame):
            self.df_loaded_swaption_vol = vol_input.copy()
        else:
            raise ValueError("vol_input must be a CSV path or a pandas DataFrame")

        required_cols = {
            "Date",
            "Swaption",
            "Volatility",
            "Swap_term",
            "Option_term",
            "Swap_term_unit",
            "Option_term_unit",
            "Model_type",
            "Shift",
        }
        missing = required_cols - set(self.df_loaded_swaption_vol.columns)
        if missing:
            raise ValueError(f"Swaption vol data missing columns: {missing}")

        self.df_loaded_swaption_vol["Date"] = pd.to_datetime(self.df_loaded_swaption_vol["Date"])
        self.df_loaded_swaption_vol["Volatility"] = self.df_loaded_swaption_vol["Volatility"].astype(float)
        self.df_loaded_swaption_vol["Swap_term"] = self.df_loaded_swaption_vol["Swap_term"].astype(int)
        self.df_loaded_swaption_vol["Option_term"] = self.df_loaded_swaption_vol["Option_term"].astype(int)
        self.df_loaded_swaption_vol["Shift"] = self.df_loaded_swaption_vol["Shift"].astype(float)
        self.df_loaded_swaption_vol["Model_type"] = self.df_loaded_swaption_vol["Model_type"].astype(str)

    @staticmethod
    def _to_ql_date(py_date) -> ql.Date:
        return ql.Date(py_date.day, py_date.month, py_date.year)

    @staticmethod
    def _to_ql_period(value: int, unit: str) -> ql.Period:
        unit = unit.upper()
        if unit == "D":
            return ql.Period(value, ql.Days)
        if unit == "W":
            return ql.Period(value, ql.Weeks)
        if unit == "M":
            return ql.Period(value, ql.Months)
        if unit == "Y":
            return ql.Period(value, ql.Years)
        raise ValueError(f"Unsupported unit: {unit}")

    @staticmethod
    def _map_model_type(model_type: str):
        mt = model_type.strip().lower()
        if mt == "normal":
            return ql.Normal
        if mt == "lognormal":
            return ql.ShiftedLognormal
        raise ValueError(f"Unsupported model_type: {model_type}")

    def prepare_ql_term_structure(
        self,
        test_date: pd.Timestamp,
        df_curve_date: pd.DataFrame
    ) -> ql.YieldTermStructureHandle:
        """
        Build QuantLib zero curve from local curve data for one date.

        Curve input example for one date:
        Tenor  Rate
        7      0.049052
        30     0.048880
        365    0.041622
        """
        df_curve_date = df_curve_date.sort_values("Tenor").copy()

        ql_eval_date = self._to_ql_date(test_date)
        ql.Settings.instance().evaluationDate = ql_eval_date

        dates = [ql_eval_date + int(x) for x in df_curve_date["Tenor"].tolist()]
        rates = df_curve_date["Rate"].tolist()

        curve = ql.ZeroCurve(dates, rates, ql.Actual365Fixed())
        return ql.YieldTermStructureHandle(curve)


class HW1FCalibSW(HW1FCalibBase):
    """
    Local standalone Hull-White 1F calibrator using swaption ATM implied vols.
    """

    def __init__(
        self,
        swaption_strike_type: str = "ATM",
        output_folder: str = "output",
        currency: str = "USD"
    ):
        super().__init__(output_folder=output_folder, currency=currency)
        self.swaption_strike_type = swaption_strike_type

    def calibrate_hw_1f_ql(
        self,
        test_date: pd.Timestamp,
        df_curve_date: pd.DataFrame,
        df_swaption_vol_date: pd.DataFrame,
        model_type: str = "Normal",
        shift: float = 0.0,
        mu: Optional[float] = None,
        sigma: Optional[float] = None,
        opt_para: Optional[List[float]] = None,
    ) -> Tuple[float, float]:
        """
        Calibrate Hull-White 1F for a single date.

        Returns:
        (mu, sigma)

        If mu is provided, it is fixed and only sigma is calibrated.
        If sigma is provided, it is fixed and only mu is calibrated.
        If neither is provided, both are calibrated.
        """

        if opt_para is None:
            # [maxIterations, maxStationaryStateIterations, rootEpsilon, functionEpsilon, gradientNormEpsilon]
            opt_para = [10000, 1000, 1e-8, 1e-8, 1e-8]

        term_structure = self.prepare_ql_term_structure(test_date, df_curve_date)

        # Initial values
        init_mu = 0.10 if mu is None else float(mu)
        init_sigma = 0.01 if sigma is None else float(sigma)

        model = ql.HullWhite(term_structure, init_mu, init_sigma)
        engine = ql.JamshidianSwaptionEngine(model)

        helpers = []

        # Common conventions for a simplified standalone version
        fixed_leg_tenor = ql.Period(1, ql.Years)
        fixed_leg_daycounter = ql.Actual365Fixed()
        floating_leg_daycounter = ql.Actual365Fixed()
        index = ql.USDLibor(ql.Period(3, ql.Months), term_structure)

        vol_type = self._map_model_type(model_type)

        df_swaption_vol_date = df_swaption_vol_date.copy()

        for _, row in df_swaption_vol_date.iterrows():
            volatility = float(row["Volatility"])
            swap_term = int(row["Swap_term"])
            option_term = int(row["Option_term"])
            swap_unit = row["Swap_term_unit"]
            option_unit = row["Option_term_unit"]

            option_period = self._to_ql_period(option_term, option_unit)
            swap_period = self._to_ql_period(swap_term, swap_unit)

            vol_handle = ql.QuoteHandle(ql.SimpleQuote(volatility))

            helper = ql.SwaptionHelper(
                option_period,
                swap_period,
                vol_handle,
                index,
                fixed_leg_tenor,
                fixed_leg_daycounter,
                floating_leg_daycounter,
                term_structure,
                ql.BlackCalibrationHelper.RelativePriceError,
                ql.nullDouble(),
                1.0,
                vol_type,
                shift
            )
            helper.setPricingEngine(engine)
            helpers.append(helper)

        lm = ql.LevenbergMarquardt()
        end_criteria = ql.EndCriteria(
            int(opt_para[0]),
            int(opt_para[1]),
            float(opt_para[2]),
            float(opt_para[3]),
            float(opt_para[4]),
        )

        if mu is not None:
            fixed_parameters = [True, False]
        elif sigma is not None:
            fixed_parameters = [False, True]
        else:
            fixed_parameters = [False, False]

        model.calibrate(
            helpers,
            lm,
            end_criteria,
            ql.NoConstraint(),
            [],
            fixed_parameters
        )

        calibrated_mu, calibrated_sigma = model.params()
        return float(calibrated_mu), float(calibrated_sigma)

    def compute_hw_1f_local(
        self,
        start_date: str,
        end_date: str,
        model_type: Optional[str] = None,
        shift: Optional[float] = None,
        mu: Optional[float] = None,
        sigma: Optional[float] = None,
        opt_para: Optional[List[float]] = None,
        save_csv: bool = True,
    ) -> pd.DataFrame:
        """
        Run calibration for all dates between start_date and end_date found in the local files.
        """

        if self.df_loaded_curve is None:
            raise ValueError("Curve data not loaded. Use load_curve() first.")
        if self.df_loaded_swaption_vol is None:
            raise ValueError("Swaption vol data not loaded. Use load_swaption_vol() first.")

        start_date = pd.to_datetime(start_date)
        end_date = pd.to_datetime(end_date)

        df_curve = self.df_loaded_curve.copy()
        df_vol = self.df_loaded_swaption_vol.copy()

        df_curve = df_curve[(df_curve["Date"] >= start_date) & (df_curve["Date"] <= end_date)]
        df_vol = df_vol[(df_vol["Date"] >= start_date) & (df_vol["Date"] <= end_date)]

        result_rows = []
        error_rows = []

        common_dates = sorted(set(df_curve["Date"].unique()).intersection(set(df_vol["Date"].unique())))

        for d in common_dates:
            d = pd.Timestamp(d)

            df_curve_date = df_curve[df_curve["Date"] == d].copy()
            df_vol_date = df_vol[df_vol["Date"] == d].copy()

            if df_curve_date.empty:
                error_rows.append([d, "Missing curve data"])
                continue
            if df_vol_date.empty:
                error_rows.append([d, "Missing swaption vol data"])
                continue

            try:
                mt = model_type if model_type is not None else str(df_vol_date.iloc[0]["Model_type"])
                sh = shift if shift is not None else float(df_vol_date.iloc[0]["Shift"])

                cal_mu, cal_sigma = self.calibrate_hw_1f_ql(
                    test_date=d,
                    df_curve_date=df_curve_date,
                    df_swaption_vol_date=df_vol_date,
                    model_type=mt,
                    shift=sh,
                    mu=mu,
                    sigma=sigma,
                    opt_para=opt_para,
                )

                result_rows.append([d, cal_mu, cal_sigma, self.currency, mt, sh])

            except Exception as e:
                error_rows.append([d, str(e)])

        df_result = pd.DataFrame(
            result_rows,
            columns=["Date", "Mu", "Sigma", "Currency", "Model_type", "Shift"]
        )

        df_error = pd.DataFrame(error_rows, columns=["Date", "Error"])

        if save_csv:
            result_path = os.path.join(
                self.output_folder,
                f"HW1F_MuSigma_{self.currency}_{start_date.strftime('%Y%m%d')}_{end_date.strftime('%Y%m%d')}.csv"
            )
            error_path = os.path.join(
                self.output_folder,
                f"HW1F_Errors_{self.currency}_{start_date.strftime('%Y%m%d')}_{end_date.strftime('%Y%m%d')}.csv"
            )
            df_result.to_csv(result_path, index=False)
            df_error.to_csv(error_path, index=False)

        return df_result


