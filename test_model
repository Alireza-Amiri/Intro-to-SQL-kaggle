import os
import math
from typing import Optional, List, Tuple

import pandas as pd
import QuantLib as ql


class HW1FLocalCCAR:
    def __init__(self, output_folder: str = "output", currency: str = "USD"):
        self.output_folder = output_folder
        self.currency = currency.upper()
        os.makedirs(self.output_folder, exist_ok=True)

    # =========================================================
    # STEP 1 - READ LOCAL EXCEL FILES
    # =========================================================
    @staticmethod
    def read_excel_file(file_path: str, sheet_name=0) -> pd.DataFrame:
        return pd.read_excel(file_path, sheet_name=sheet_name)

    # =========================================================
    # STEP 2 - STANDARDIZE BASELINE CURVE
    # =========================================================
    @staticmethod
    def prepare_curve_df(df_curve: pd.DataFrame) -> pd.DataFrame:
        """
        Expected columns from your screenshot:
        Curve, Date, Tenor, Rate, ZC rate, DF
        """
        df = df_curve.copy()

        required = ["Date", "Tenor", "Rate"]
        missing = [c for c in required if c not in df.columns]
        if missing:
            raise ValueError(f"Curve file missing columns: {missing}")

        df["Date"] = pd.to_datetime(df["Date"])
        df["Tenor"] = df["Tenor"].astype(int)
        df["Rate"] = df["Rate"].astype(float)

        if "Curve" in df.columns:
            df = df[df["Curve"].astype(str).str.upper().str.contains("SOFR", na=False)]

        return df[["Date", "Tenor", "Rate"]].sort_values(["Date", "Tenor"]).reset_index(drop=True)

    # =========================================================
    # STEP 3 - STANDARDIZE BASELINE SWAPTION VOL
    # =========================================================
    @staticmethod
    def prepare_swaption_vol_df(df_vol: pd.DataFrame) -> pd.DataFrame:
        """
        Expected columns from your screenshot:
        Date, Swaption, Currency, Volatility, Swap_term, Option_term,
        Swap_term_unit, Option_term_unit, Data_type, Model_type, Shift
        """
        df = df_vol.copy()

        required = [
            "Date", "Volatility", "Swap_term", "Option_term",
            "Swap_term_unit", "Option_term_unit", "Model_type", "Shift"
        ]
        missing = [c for c in required if c not in df.columns]
        if missing:
            raise ValueError(f"Swaption vol file missing columns: {missing}")

        df["Date"] = pd.to_datetime(df["Date"])
        df["Volatility"] = df["Volatility"].astype(float)

        # Your screenshot suggests these may already be numeric
        df["Swap_term"] = df["Swap_term"].astype(int)
        df["Option_term"] = df["Option_term"].astype(int)

        df["Swap_term_unit"] = df["Swap_term_unit"].astype(str).str.upper()
        df["Option_term_unit"] = df["Option_term_unit"].astype(str).str.upper()
        df["Model_type"] = df["Model_type"].astype(str)
        df["Shift"] = df["Shift"].astype(float)

        return df.sort_values(["Date"]).reset_index(drop=True)

    # =========================================================
    # STEP 4 - STANDARDIZE CURVE SHOCK FILE
    # =========================================================
    @staticmethod
    def prepare_curve_shock_df(df_curve_shock: pd.DataFrame) -> pd.DataFrame:
        """
        Expected columns from your screenshot:
        Quarter, Curve, Currency, Tenor, Shock, Rate

        Important:
        - 'Shock' appears to be the shock type (e.g. Std)
        - 'Rate' appears to be the numeric shock value
        """
        df = df_curve_shock.copy()

        required = ["Quarter", "Tenor", "Shock", "Rate"]
        missing = [c for c in required if c not in df.columns]
        if missing:
            raise ValueError(f"Curve shock file missing columns: {missing}")

        df["Quarter"] = df["Quarter"].astype(int)
        df["Tenor"] = df["Tenor"].astype(int)
        df["ShockType"] = df["Shock"].astype(str)
        df["ShockValue"] = df["Rate"].astype(float)

        if "Curve" in df.columns:
            df = df[df["Curve"].astype(str).str.upper().str.contains("SOFR", na=False)]

        return df[["Quarter", "Tenor", "ShockType", "ShockValue"]].sort_values(["Quarter", "Tenor"]).reset_index(drop=True)

    # =========================================================
    # STEP 5 - STANDARDIZE SWAPTION VOL SHOCK FILE
    # =========================================================
    @staticmethod
    def prepare_swaption_shock_df(df_vol_shock: pd.DataFrame) -> pd.DataFrame:
        """
        Expected columns from your screenshot:
        Quarter, Swaption, Swap_term, Option_term, Shock, Volatility

        Important:
        - 'Shock' appears to be shock type (e.g. Log)
        - 'Volatility' appears to be the shock amount
        """
        df = df_vol_shock.copy()

        required = ["Quarter", "Swap_term", "Option_term", "Shock", "Volatility"]
        missing = [c for c in required if c not in df.columns]
        if missing:
            raise ValueError(f"Swaption shock file missing columns: {missing}")

        df["Quarter"] = df["Quarter"].astype(int)
        df["ShockType"] = df["Shock"].astype(str)
        df["ShockValue"] = df["Volatility"].astype(float)
        df["Option_term"] = df["Option_term"].astype(int)

        # Swap_term in your screenshot may be strings like 1Y, 2Y, 3M etc.
        df["Swap_term_raw"] = df["Swap_term"].astype(str).str.upper().str.strip()

        def parse_swap_term(x):
            if x.endswith("Y"):
                return int(x[:-1]), "Y"
            elif x.endswith("M"):
                return int(x[:-1]), "M"
            elif x.endswith("D"):
                return int(x[:-1]), "D"
            else:
                # fallback if numeric
                return int(x), "Y"

        parsed = df["Swap_term_raw"].apply(parse_swap_term)
        df["Swap_term_num"] = parsed.apply(lambda x: x[0])
        df["Swap_term_unit"] = parsed.apply(lambda x: x[1])

        # Option term looks like days from your screenshot
        df["Option_term_num"] = df["Option_term"]
        df["Option_term_unit"] = "D"

        return df[
            ["Quarter", "Swap_term_num", "Swap_term_unit", "Option_term_num",
             "Option_term_unit", "ShockType", "ShockValue"]
        ].sort_values(["Quarter"]).reset_index(drop=True)

    # =========================================================
    # STEP 6 - QUANTLIB HELPERS
    # =========================================================
    @staticmethod
    def to_ql_date(py_date) -> ql.Date:
        return ql.Date(py_date.day, py_date.month, py_date.year)

    @staticmethod
    def to_ql_period(value: int, unit: str) -> ql.Period:
        unit = str(unit).upper()
        if unit == "D":
            return ql.Period(value, ql.Days)
        elif unit == "W":
            return ql.Period(value, ql.Weeks)
        elif unit == "M":
            return ql.Period(value, ql.Months)
        elif unit == "Y":
            return ql.Period(value, ql.Years)
        else:
            raise ValueError(f"Unsupported unit: {unit}")

    @staticmethod
    def map_model_type(model_type: str):
        mt = str(model_type).strip().lower()
        if mt == "normal":
            return ql.Normal
        elif mt == "lognormal":
            return ql.ShiftedLognormal
        else:
            raise ValueError(f"Unsupported model type: {model_type}")

    # =========================================================
    # STEP 7 - BUILD TERM STRUCTURE
    # =========================================================
    def build_term_structure(self, valuation_date: pd.Timestamp, df_curve_date: pd.DataFrame):
        ql_date = self.to_ql_date(valuation_date)
        ql.Settings.instance().evaluationDate = ql_date

        df_curve_date = df_curve_date.sort_values("Tenor").copy()

        dates = [ql_date + int(x) for x in df_curve_date["Tenor"].tolist()]
        rates = df_curve_date["Rate"].tolist()

        curve = ql.ZeroCurve(dates, rates, ql.Actual365Fixed())
        return ql.YieldTermStructureHandle(curve)

    # =========================================================
    # STEP 8 - BASELINE OR STRESSED CALIBRATION
    # =========================================================
    def calibrate_hw_1f(
        self,
        valuation_date: pd.Timestamp,
        df_curve_date: pd.DataFrame,
        df_vol_date: pd.DataFrame,
        mu: Optional[float] = None,
        sigma: Optional[float] = None,
        opt_para: Optional[List[float]] = None,
    ) -> Tuple[float, float]:
        """
        Calibrate HW 1F on one date.
        """
        if opt_para is None:
            opt_para = [10000, 1000, 1e-8, 1e-8, 1e-8]

        term_structure = self.build_term_structure(valuation_date, df_curve_date)

        model_type = str(df_vol_date.iloc[0]["Model_type"])
        shift = float(df_vol_date.iloc[0]["Shift"])

        init_mu = 0.10 if mu is None else float(mu)
        init_sigma = 0.01 if sigma is None else float(sigma)

        model = ql.HullWhite(term_structure, init_mu, init_sigma)
        engine = ql.JamshidianSwaptionEngine(model)

        fixed_leg_tenor = ql.Period(1, ql.Years)
        fixed_leg_daycounter = ql.Actual365Fixed()
        floating_leg_daycounter = ql.Actual365Fixed()
        index = ql.USDLibor(ql.Period(3, ql.Months), term_structure)

        helpers = []

        for _, row in df_vol_date.iterrows():
            option_period = self.to_ql_period(int(row["Option_term"]), row["Option_term_unit"])
            swap_period = self.to_ql_period(int(row["Swap_term"]), row["Swap_term_unit"])
            vol = float(row["Volatility"])

            vol_handle = ql.QuoteHandle(ql.SimpleQuote(vol))

            helper = ql.SwaptionHelper(
                option_period,
                swap_period,
                vol_handle,
                index,
                fixed_leg_tenor,
                fixed_leg_daycounter,
                floating_leg_daycounter,
                term_structure,
                ql.BlackCalibrationHelper.RelativePriceError,
                ql.nullDouble(),
                1.0,
                self.map_model_type(model_type),
                shift
            )
            helper.setPricingEngine(engine)
            helpers.append(helper)

        lm = ql.LevenbergMarquardt()
        end_criteria = ql.EndCriteria(
            int(opt_para[0]),
            int(opt_para[1]),
            float(opt_para[2]),
            float(opt_para[3]),
            float(opt_para[4]),
        )

        if mu is not None:
            fixed_parameters = [True, False]
        elif sigma is not None:
            fixed_parameters = [False, True]
        else:
            fixed_parameters = [False, False]

        model.calibrate(
            helpers,
            lm,
            end_criteria,
            ql.NoConstraint(),
            [],
            fixed_parameters
        )

        cal_mu, cal_sigma = model.params()
        return float(cal_mu), float(cal_sigma)

    # =========================================================
    # STEP 9 - APPLY CURVE SHOCKS
    # =========================================================
    @staticmethod
    def apply_curve_shocks(
        df_curve_date: pd.DataFrame,
        df_curve_shock_q: pd.DataFrame,
        curve_shock_mode: str = "additive_decimal"
    ) -> pd.DataFrame:
        """
        Applies quarterly curve shocks.

        curve_shock_mode options:
        - additive_decimal : shocked_rate = base_rate + shock
        - additive_bps     : shocked_rate = base_rate + shock * 0.0001

        Use additive_bps if shock values are in basis points.
        Use additive_decimal if shock values are already decimal rates.
        """
        df_base = df_curve_date.copy()
        df_shock = df_curve_shock_q.copy()

        merged = df_base.merge(
            df_shock[["Tenor", "ShockValue"]],
            on="Tenor",
            how="left"
        )

        if merged["ShockValue"].isna().any():
            missing_tenors = merged.loc[merged["ShockValue"].isna(), "Tenor"].tolist()
            raise ValueError(f"Missing curve shock for tenors: {missing_tenors}")

        if curve_shock_mode == "additive_decimal":
            merged["Rate"] = merged["Rate"] + merged["ShockValue"]
        elif curve_shock_mode == "additive_bps":
            merged["Rate"] = merged["Rate"] + merged["ShockValue"] * 0.0001
        else:
            raise ValueError(f"Unsupported curve_shock_mode: {curve_shock_mode}")

        return merged[["Date", "Tenor", "Rate"]].copy()

    # =========================================================
    # STEP 10 - APPLY SWAPTION VOL SHOCKS
    # =========================================================
    @staticmethod
    def apply_vol_shocks(
        df_vol_date: pd.DataFrame,
        df_vol_shock_q: pd.DataFrame
    ) -> pd.DataFrame:
        """
        Applies quarterly swaption vol shocks.

        Based on your documentation:
        if shock type = Log,
            shocked_vol = base_vol * exp(shock_value)
        """
        df_base = df_vol_date.copy()
        df_shock = df_vol_shock_q.copy()

        merged = df_base.merge(
            df_shock[
                ["Swap_term_num", "Swap_term_unit", "Option_term_num",
                 "Option_term_unit", "ShockType", "ShockValue"]
            ],
            left_on=["Swap_term", "Swap_term_unit", "Option_term", "Option_term_unit"],
            right_on=["Swap_term_num", "Swap_term_unit", "Option_term_num", "Option_term_unit"],
            how="left"
        )

        if merged["ShockValue"].isna().any():
            missing = merged.loc[merged["ShockValue"].isna(),
                                 ["Swap_term", "Swap_term_unit", "Option_term", "Option_term_unit"]]
            raise ValueError(f"Missing vol shock mappings for some swaption points:\n{missing}")

        def shock_vol(row):
            base_vol = row["Volatility"]
            shock_type = str(row["ShockType"]).strip().lower()
            shock_val = row["ShockValue"]

            if shock_type == "log":
                return base_vol * math.exp(shock_val)
            else:
                raise ValueError(f"Unsupported vol shock type: {row['ShockType']}")

        merged["Volatility"] = merged.apply(shock_vol, axis=1)

        cols_to_keep = ["Date", "Swaption", "Currency", "Volatility", "Swap_term",
                        "Option_term", "Swap_term_unit", "Option_term_unit",
                        "Data_type", "Model_type", "Shift"]

        return merged[cols_to_keep].copy()

    # =========================================================
    # STEP 11 - RUN BASELINE + 9 QUARTERS
    # =========================================================
    def run_ccar_quarters(
        self,
        curve_file: str,
        vol_file: str,
        curve_shock_file: str,
        vol_shock_file: str,
        valuation_date: str,
        curve_sheet=0,
        vol_sheet=0,
        curve_shock_sheet=0,
        vol_shock_sheet=0,
        curve_shock_mode: str = "additive_decimal",
        mu: Optional[float] = None,
        sigma: Optional[float] = None,
        save_intermediate: bool = True,
    ) -> pd.DataFrame:
        """
        Main driver.
        """

        # Read files
        raw_curve = self.read_excel_file(curve_file, sheet_name=curve_sheet)
        raw_vol = self.read_excel_file(vol_file, sheet_name=vol_sheet)
        raw_curve_shock = self.read_excel_file(curve_shock_file, sheet_name=curve_shock_sheet)
        raw_vol_shock = self.read_excel_file(vol_shock_file, sheet_name=vol_shock_sheet)

        # Prepare files
        df_curve = self.prepare_curve_df(raw_curve)
        df_vol = self.prepare_swaption_vol_df(raw_vol)
        df_curve_shock = self.prepare_curve_shock_df(raw_curve_shock)
        df_vol_shock = self.prepare_swaption_shock_df(raw_vol_shock)

        valuation_date = pd.to_datetime(valuation_date)

        df_curve_date = df_curve[df_curve["Date"] == valuation_date].copy()
        df_vol_date = df_vol[df_vol["Date"] == valuation_date].copy()

        if df_curve_date.empty:
            raise ValueError(f"No baseline curve data found for {valuation_date}")
        if df_vol_date.empty:
            raise ValueError(f"No baseline swaption vol data found for {valuation_date}")

        # Baseline
        base_mu, base_sigma = self.calibrate_hw_1f(
            valuation_date=valuation_date,
            df_curve_date=df_curve_date,
            df_vol_date=df_vol_date,
            mu=mu,
            sigma=sigma
        )

        result_rows = [[valuation_date, 0, "Baseline", base_mu, base_sigma]]

        # Run all quarters
        available_quarters = sorted(df_curve_shock["Quarter"].unique())

        for q in available_quarters:
            df_curve_shock_q = df_curve_shock[df_curve_shock["Quarter"] == q].copy()
            df_vol_shock_q = df_vol_shock[df_vol_shock["Quarter"] == q].copy()

            shocked_curve = self.apply_curve_shocks(
                df_curve_date=df_curve_date,
                df_curve_shock_q=df_curve_shock_q,
                curve_shock_mode=curve_shock_mode
            )

            shocked_vol = self.apply_vol_shocks(
                df_vol_date=df_vol_date,
                df_vol_shock_q=df_vol_shock_q
            )

            if save_intermediate:
                shocked_curve.to_csv(
                    os.path.join(self.output_folder, f"Shocked_Curve_Q{q}.csv"),
                    index=False
                )
                shocked_vol.to_csv(
                    os.path.join(self.output_folder, f"Shocked_SwaptionVol_Q{q}.csv"),
                    index=False
                )

            q_mu, q_sigma = self.calibrate_hw_1f(
                valuation_date=valuation_date,
                df_curve_date=shocked_curve,
                df_vol_date=shocked_vol,
                mu=mu,
                sigma=sigma
            )

            result_rows.append([valuation_date, q, f"Quarter_{q}", q_mu, q_sigma])

        df_result = pd.DataFrame(
            result_rows,
            columns=["Date", "Quarter", "Scenario", "Mu", "Sigma"]
        )

        df_result["Mu_Shock"] = df_result["Mu"] / base_mu - 1.0 if base_mu != 0 else None
        df_result["Sigma_Shock"] = df_result["Sigma"] / base_sigma - 1.0 if base_sigma != 0 else None

        df_result.to_csv(
            os.path.join(self.output_folder, f"HW1F_CCAR_Result_{valuation_date.strftime('%Y%m%d')}.csv"),
            index=False
        )

        return df_result


